# Copy this file to .env and fill in values (NEVER commit .env)
# Values from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (SECRET) - chi dung server-side, TUYET DOI khong them
# tien to NEXT_PUBLIC_. Vercel se ma hoa bien nay cho server/edge runtime.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trên Vercel: Project Settings > Environment Variables# Vercel: da cau hinh env qua API (production + preview)

# Cloudflare R2 (upload anh san pham) - Server-side SECRETS
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# Meta (Facebook) - dang bai tu dong len Fanpage - Server-side SECRETS
# App: developers.facebook.com -> "Góc Đồ Lướt Auto Post" (mode Development)
# Permissions: pages_manage_posts, pages_read_engagement, pages_show_list
# Lay token: Graph Explorer -> /me/accounts -> chon Page -> get page access token
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_PAGE_ID=your-page-id
META_PAGE_ACCESS_TOKEN=your-page-access-token
