# Sao chep file nay thanh .env trong tung app va dien gia tri (KHONG bao gio commit .env)
# Co 2 app: apps/web (trang cong khai) va apps/admin (quan tri)

## apps/web/.env
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

## apps/admin/.env
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gia tri lay tu: Supabase Dashboard > Settings > API
# anon key la public (di kem client), service role key la SECRET chi dung server-side
# Tren Vercel them vao tung Project: Settings > Environment Variables